# Copiar como .env.local y ajustar.
# URL de los microservicios (carpeta /back)
VITE_API_PROVEEDORES=http://localhost:8080
VITE_API_COTIZACIONES=http://localhost:8082

# true = usar los datos de prueba de src/data | false = usar la API
VITE_USAR_DATOS_PRUEBA=true

