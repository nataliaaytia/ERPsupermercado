# Copiar como .env.local solo si los microservicios NO están en las rutas por defecto.
# Por defecto el front usa /srv/<servicio>, que reenvían nginx (Docker) o Vite (desarrollo).
# VITE_API_PROVEEDORES=/srv/proveedores
# VITE_API_COTIZACIONES=/srv/cotizaciones
# VITE_API_ORDENES=/srv/ordenes
# VITE_API_RECEPCION=/srv/recepcion

# Publicadores Pub/Sub del equipo (opcionales)
# VITE_ORDEN_COMPRA_CONTABILIDAD_API=
# VITE_MERCADERIA_DISPONIBLE_API=
